[submodule "plugins/tmux-powerline"]
	path = plugins/tmux-powerline
	url = https://git::@github.com/erikw/tmux-powerline
[submodule "plugins/tmux-prefix-highlight"]
	path = plugins/tmux-prefix-highlight
	url = https://git::@github.com/tmux-plugins/tmux-prefix-highlight
[submodule "plugins/tmux-sensible"]
	path = plugins/tmux-sensible
	url = https://git::@github.com/tmux-plugins/tmux-sensible
[submodule "plugins/tpm"]
	path = plugins/tpm
	url = https://git::@github.com/tmux-plugins/tpm
[submodule "plugins/smart-splits.nvim"]
	path = plugins/smart-splits.nvim
	url = https://github.com/mrjones2014/smart-splits.nvim
[submodule "tmux-urlview"]
    path = tmux-urlview
    url = https://github.com/tmux-plugins/tmux-urlview.git
